rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
    }
    match /games/{gameId} {
      allow read, create, update, delete: if true;
    }
    match /matchmaking/{matchId} {
      allow read, write: if true;
    }
    match /invitations/{inviteId} {
      allow read, create, update, delete: if true;
    }
  }
}
